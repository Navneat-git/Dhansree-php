APP_NAME=Dhansree
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=dhansree_php_dev
DB_USERNAME=dhansree
DB_PASSWORD=

# Sessions are kept on disk, NOT in the database. The database schema is owned by the Node
# application's Prisma migrations during the migration (see docs/MIGRATION_PLAN.md section 7),
# so Laravel must not add a `sessions` table to it. Revisit once Prisma no longer owns DDL.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Same constraint as sessions above: no `jobs` table while Prisma owns the schema.
QUEUE_CONNECTION=sync

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Dhansree ─────────────────────────────────────────────────────────────────
# The public address of the storefront.
SITE_URL=http://localhost:8000

# Display timezone only. Timestamps are stored in UTC (see config/app.php).
STORE_TIMEZONE=Asia/Kolkata

# 32 random bytes, base64. Encrypts admin authenticator seeds (AES-256-GCM).
# MUST be byte-identical to the Node application's SECRET_ENCRYPTION_KEY if you want the existing
# admin_totp_credentials rows to decrypt — see app/Support/Crypto/SecretBox.php.
#   php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
SECRET_ENCRYPTION_KEY=

# ── Media ────────────────────────────────────────────────────────────────────
# Product media is served from an external asset host, not from this application's directory.
MEDIA_PUBLIC_BASE_URL=https://assets.dhansree.com/ds-web

# ── Feature switches (COD-only launch) ───────────────────────────────────────
# Both off means: cash on delivery only, with online payment and courier booking hidden.
RAZORPAY_ENABLED=false
SHIPROCKET_ENABLED=false

# ── Online payments (Razorpay) ───────────────────────────────────────────────
# Use TEST keys (rzp_test_…) everywhere except production. Server-only secrets: never commit.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Shiprocket ───────────────────────────────────────────────────────────────
# NOTE: Shiprocket has no sandbox. Real credentials change your real account.
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_TOKEN=
